{
  "name": "@wscanplus/theme",
  "version": "0.1.0",
  "description": "Shared TS theme tokens for wscan+ desktop and web UIs",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css"
  },
  "scripts": {
    "build": "echo 'theme package is source-only; consumers transpile via Vite'",
    "test": "node --test tests/*.test.js",
    "lint": "eslint . --max-warnings=0",
    "generate": "node scripts/generate-from-design-tokens.mjs"
  },
  "files": ["src/", "scripts/"],
  "engines": { "node": ">=22.0.0" },
